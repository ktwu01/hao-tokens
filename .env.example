# =============================================================================
# Hao Tokens — Environment Variables
# Copy this file to .env and fill in your keys. Never commit .env.
# Keep real credentials in .env only; this template should use placeholders.
# Last updated: 2026-05-23.
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI
# Docs: https://platform.openai.com/docs/models
# GPT-4o retiring April 3 2026 in ChatGPT but remains in API.
# GPT-4.1 series (April 2025) is now the recommended non-reasoning family.
# o4-mini is the current best reasoning model for coding tasks.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.openai.com/v1

# Model IDs (pinned for reproducibility)
OPENAI_MODEL_GPT4O=gpt-4o-2024-11-20              # legacy, pre-4.1 baseline
OPENAI_MODEL_GPT41=gpt-4.1-2025-04-14             # best non-reasoning coding model
OPENAI_MODEL_GPT41_MINI=gpt-4.1-mini-2025-04-14   # cost-efficient
OPENAI_MODEL_GPT41_NANO=gpt-4.1-nano-2025-04-14   # fastest/cheapest
OPENAI_MODEL_O3=o3-2025-04-16                     # reasoning
OPENAI_MODEL_GPT55=gpt-5.5-2026-04-23             # latest flagship, 128K output, 1.05M context
OPENAI_MODEL_GPT54=gpt-5.4-2026-03-05             # previous flagship, 128K output, 1M context
OPENAI_MODEL_GPT54_MINI=gpt-5.4-mini-2025-08-31   # cost-efficient, 128K output

# -----------------------------------------------------------------------------
# Anthropic Claude
# Docs: https://docs.anthropic.com/en/docs/about-claude/models
# Haiku 3 (claude-3-haiku-20240307) retires April 19 2026.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_BASE=https://api.anthropic.com

# Model IDs (4.6 series is current as of March 2026)
ANTHROPIC_MODEL_OPUS=claude-opus-4-6               # most intelligent, best for coding agents
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6           # balanced
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001    # fast/cheap

# -----------------------------------------------------------------------------
# Google Gemini
# Docs: https://ai.google.dev/gemini-api/docs/models
# Gemini 3.x series launched 2025/2026.
# gemini-3-pro-preview was SHUT DOWN March 9 2026 — do not use.
# Use gemini-3.1-pro-preview or gemini-3.1-flash-lite-preview.
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=AIza...
GOOGLE_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Gemini 3.1 models (use these — 3.0 pro-preview is dead)
GEMINI_MODEL_31_PRO=gemini-3.1-pro-preview               # agent evaluation baseline (SOTA)
GEMINI_MODEL_3_FLASH=gemini-3-flash-preview              # fast/cheap general use
GEMINI_MODEL_31_FLASH_LITE=gemini-3.1-flash-lite-preview # task generation pipeline (generate_tasks.py)

# -----------------------------------------------------------------------------
# Moonshot Kimi
# Docs: https://platform.moonshot.ai/docs
# Account / balance (CNY): https://platform.kimi.com/console/account
# Kimi K2 is an agentic, coding-focused MoE model.
# Kimi K2.5 native Moonshot ID unconfirmed — JS-rendered docs; verify at:
#   https://platform.moonshot.ai/docs/guide/kimi-k2-5-quickstart
# International endpoint (use api.moonshot.cn/v1 if in China)
# -----------------------------------------------------------------------------
MOONSHOT_API_KEY=sk-...
MOONSHOT_API_BASE=https://api.moonshot.ai/v1

# Model IDs
MOONSHOT_MODEL_K2=kimi-k2-0905-preview             # latest K2 snapshot, best for coding
MOONSHOT_MODEL_K2_PREV=kimi-k2-0711-preview        # earlier K2 snapshot

# Via OpenRouter (if native Moonshot key unavailable):
# OPENROUTER_MODEL_KIMI_K25=moonshotai/kimi-k2.5

# -----------------------------------------------------------------------------
# NVIDIA NIM / NVIDIA API Catalog
# Docs: https://docs.api.nvidia.com/nim/reference/llm-apis
# Models: https://build.nvidia.com/models
# Example model docs: https://docs.api.nvidia.com/nim/reference/meta-llama-3_3-70b-instruct
# OpenAI-compatible endpoint: POST /v1/chat/completions.
# NVIDIA NIM uses provider-prefixed model IDs, for example:
#   deepseek-ai/deepseek-v4-pro
#   deepseek-ai/deepseek-v4-flash
#   minimaxai/minimax-m2.7
#   meta/llama-3.3-70b-instruct
# -----------------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-...
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_MODEL_DEEPSEEK_V4_PRO=deepseek-ai/deepseek-v4-pro
NVIDIA_MODEL_DEEPSEEK_V4_FLASH=deepseek-ai/deepseek-v4-flash
NVIDIA_MODEL_MINIMAX_M27=minimaxai/minimax-m2.7
NVIDIA_MODEL_MISTRAL_NEMOTRON=mistralai/mistral-nemotron
NVIDIA_MODEL_LLAMA33_70B=meta/llama-3.3-70b-instruct
NVIDIA_MODEL_LLAMA31_70B=meta/llama-3.1-70b-instruct
NVIDIA_MODEL_LLAMA31_8B=meta/llama-3.1-8b-instruct
NVIDIA_MODEL_PHI4_MINI=microsoft/phi-4-mini-instruct       # api may return very slowly
NVIDIA_MODEL_LLAMA32_1B=meta/llama-3.2-1b-instruct         # api may return very slowly

# Some tools only know the generic OpenAI-compatible variable names.
# Set these to whichever compatible provider you want that tool to use.
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1

# -----------------------------------------------------------------------------
# OpenRouter
# Docs: https://openrouter.ai/docs
# Free model collection: https://openrouter.ai/collections/free-models
# OpenAI-compatible endpoint.
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL_FREE=deepseek/deepseek-r1:free
OPENROUTER_MODEL_AUTO=openrouter/auto
OPENROUTER_HTTP_REFERER=https://your-site.example
OPENROUTER_TITLE=Hao Tokens

# -----------------------------------------------------------------------------
# Cerebras
# Docs: https://inference-docs.cerebras.ai/
# OpenAI-compatible endpoint.
# -----------------------------------------------------------------------------
CEREBRAS_API_KEY=csk-...
CEREBRAS_API_BASE=https://api.cerebras.ai/v1

# -----------------------------------------------------------------------------
# SambaNova
# Docs: https://docs.sambanova.ai/
# OpenAI-compatible endpoint.
# -----------------------------------------------------------------------------
SAMBANOVA_API_KEY=...
SAMBANOVA_API_BASE=https://api.sambanova.ai/v1

# -----------------------------------------------------------------------------
# Together AI
# Docs: https://docs.together.ai/docs/openai-api-compatibility
# OpenAI-compatible endpoint.
# -----------------------------------------------------------------------------
TOGETHER_API_KEY=...
TOGETHER_API_BASE=https://api.together.xyz/v1

# -----------------------------------------------------------------------------
# Cloudflare Workers AI
# Docs: https://developers.cloudflare.com/workers-ai/
# OpenAI-compatible endpoint includes your account ID.
# -----------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_ACCOUNT_ID=...
CLOUDFLARE_AI_API_BASE=https://api.cloudflare.com/client/v4/accounts/${CLOUDFLARE_ACCOUNT_ID}/ai/v1

# -----------------------------------------------------------------------------
# GitHub Models
# Docs: https://docs.github.com/en/github-models
# OpenAI-compatible endpoint; use a GitHub personal access token.
# -----------------------------------------------------------------------------
GITHUB_TOKEN=github_pat_...
GITHUB_MODELS_API_BASE=https://models.github.ai/inference

# -----------------------------------------------------------------------------
# AMD Developer Cloud
# AMD provides GPU hours, not a managed inference API. Set this to your
# self-hosted OpenAI-compatible vLLM/SGLang/llama.cpp endpoint.
# -----------------------------------------------------------------------------
AMD_OPENAI_API_BASE=http://YOUR_VM:8000/v1

# -----------------------------------------------------------------------------
# Alibaba Qwen / Qwen3-Coder
# Docs: https://www.alibabacloud.com/help/en/model-studio/qwen-coder
# Qwen3-Coder series (2025) replaces Qwen2.5-Coder as recommended coding model.
# OpenAI-compatible endpoint.
# International endpoint (use dashscope.aliyuncs.com if in China)
# -----------------------------------------------------------------------------
DASHSCOPE_API_KEY=sk-...
DASHSCOPE_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Model IDs
QWEN_MODEL_CODER_NEXT=qwen3-coder-next             # recommended balance of quality/speed
QWEN_MODEL_CODER_PLUS=qwen3-coder-plus-2025-07-22  # highest quality, complex tasks (pinned)
QWEN_MODEL_CODER_FLASH=qwen3-coder-flash           # cost-efficient, supports context cache
QWEN_MODEL_CODER_25=qwen2.5-coder-32b-instruct     # previous gen, still available

# -----------------------------------------------------------------------------
# DeepSeek
# Docs: https://api-docs.deepseek.com/
# Pricing: https://api-docs.deepseek.com/quick_start/pricing
# Console / API key: https://platform.deepseek.com/api_keys
# Balance (CNY): https://platform.deepseek.com/usage
# OpenAI-compatible API. v4-flash is the default cheap pipeline model.
# Pricing (verified 2026-05-06):
#   v4-flash: $0.14 / $0.28 per MTok in/out (cache miss); 1M ctx, 384K out
#   v4-pro:   $0.435 / $0.87 per MTok in/out (75% discount until 2026-05-31)
# Legacy IDs deepseek-chat / deepseek-reasoner deprecated 2026-07-24.
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-...                   # TODO: get from https://platform.deepseek.com/
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Model IDs (current as of 2026-05-06)
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash    # cheap default for pipeline
DEEPSEEK_MODEL_PRO=deepseek-v4-pro        # higher quality, more expensive
DEEPSEEK_MODEL_CHAT=deepseek-chat         # legacy alias, deprecates 2026-07-24
DEEPSEEK_MODEL_REASONER=deepseek-reasoner # legacy alias, deprecates 2026-07-24

# -----------------------------------------------------------------------------
# MiniMax
# Docs (OpenAI-compat): https://platform.minimax.io/docs/api-reference/text-openai-api
# Docs (models):        https://platform.minimax.io/docs/guides/models-intro
# Docs (text gen):      https://platform.minimax.io/docs/guides/text-generation
# Console / API key:    https://platform.minimax.io/
# Token plan / balance: https://platform.minimaxi.com/user-center/payment/token-plan
# HuggingFace weights:  https://huggingface.co/MiniMaxAI/MiniMax-M2.7
#
# OpenAI-compatible API. M2.7 is the latest flagship (204K context, ~60 tps).
# Highspeed variant: MiniMax-M2.7-highspeed (~100 tps, same quality).
# Pricing: check console (not published in docs as of 2026-04-30).
#          TODO: fill in $/MTok input and output after checking console.
# -----------------------------------------------------------------------------
MINIMAX_API_KEY=sk-cp-...                     # TODO: get from MiniMax console
MINIMAX_API_BASE=https://api.minimax.io/v1

# Model IDs
MINIMAX_MODEL_M27=MiniMax-M2.7                # standard, ~60 tps
MINIMAX_MODEL_M27_FAST=MiniMax-M2.7-highspeed # ~100 tps, same quality

# -----------------------------------------------------------------------------
# Groq -- fast inference for open-weight models (Llama, etc.)
# Docs: https://console.groq.com/docs/models
# OpenAI-compatible API
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_...
GROQ_API_BASE=https://api.groq.com/openai/v1

# Model IDs
GROQ_MODEL_LLAMA33_70B=llama-3.3-70b-versatile
GROQ_MODEL_LLAMA31_8B=llama-3.1-8b-instant

# -----------------------------------------------------------------------------
# Mistral
# Docs: https://docs.mistral.ai/getting-started/models/models_overview/
# -----------------------------------------------------------------------------
MISTRAL_API_KEY=...
MISTRAL_API_BASE=https://api.mistral.ai/v1

# Model IDs
MISTRAL_MODEL_LARGE=mistral-large-latest    # auto-updated to latest Mistral Large
MISTRAL_MODEL_CODESTRAL=codestral-latest    # code-specialized model

# -----------------------------------------------------------------------------
# HuggingFace
# Docs: https://huggingface.co/docs/hub/security-tokens
# Used for uploading the dataset to the HuggingFace Hub.
# Get your token at: https://huggingface.co/settings/tokens
# -----------------------------------------------------------------------------
HF_TOKEN=hf_...

# -----------------------------------------------------------------------------
# AWS Bedrock (bearer token auth — not SigV4)
# Docs: https://docs.aws.amazon.com/bedrock/latest/userguide/api-keys-use.html
# Used for task generation (Claude Opus as Stage 1 generator).
# Bearer token avoids SigV4 complexity — just set the token.
# -----------------------------------------------------------------------------
AWS_BEARER_TOKEN_BEDROCK=ABSK...
AWS_BEDROCK_REGION=us-west-2
# Default: Haiku (cheap, $1/$5). Use Sonnet for higher quality. NEVER default to Opus ($15/$75).
AWS_BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-6
# AWS_BEDROCK_MODEL=us.anthropic.claude-opus-4-7

# =============================================================================
# ESM-bench experiment settings (not API keys)
# =============================================================================

# Task dataset version — single source of truth for all pipeline scripts.
# Bump this when regenerating tasks (e.g. after fixing truncation, prompts, etc.)
# All scripts resolve task paths as: data/tasks_v${TASKS_VERSION}/<repo>/
TASKS_VERSION=4

# Prompt ablation tier (1=baseline, 2=subroutine hints, 3=deleted lines)
# All tiers share same source files; only prompt text changes.
PROMPT_TIER=1

# Sampling parameters for agent evaluation
AGENT_TEMPERATURE=0.8
AGENT_K_SAMPLES=5           # number of samples per task per model
AGENT_MAX_TOKENS=4096

# Max input tokens per task (skip tasks exceeding this). Controls cost.
# 10K tokens ~ 40K chars. Set to 0 to disable.
MAX_INPUT_TOKENS=10000

# Default model for pipeline runs. DeepSeek v4-flash is cheapest at scale.
# Use SOTA models (gpt55, claude_opus) only for final benchmark runs.
EXPERIMENT_MODELS=deepseek_v4_flash

# HPC settings
SLURM_PARTITION=gpu
SLURM_TIME=00:45:00
SLURM_CPUS=4
SLURM_MEM=16G
